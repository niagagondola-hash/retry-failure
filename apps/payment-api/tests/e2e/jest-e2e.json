{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "tests/e2e/.*\\.e2e-spec\\.ts$",
  "passWithNoTests": true,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true,
          "module": "commonjs",
          "target": "ES2022",
          "esModuleInterop": true,
          "skipLibCheck": true,
          "strict": false
        },
        "isolatedModules": true
      }
    ]
  },
  "testTimeout": 180000,
  "verbose": true
}
