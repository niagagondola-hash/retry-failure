{
  "name": "payment-api",
  "version": "0.1.0",
  "private": true,
  "description": "Payment API - NestJS 11 + TypeORM + Cockatiel + PostgreSQL",
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./tests/e2e/jest-e2e.json --runInBand",
    "test:e2e:file": "jest --config ./tests/e2e/jest-e2e.json --runInBand",
    "test:e2e:transient": "jest --config ./tests/e2e/jest-e2e.json --runInBand tests/e2e/payments.transient.e2e-spec.ts",
    "test:e2e:permanent": "jest --config ./tests/e2e/jest-e2e.json --runInBand tests/e2e/payments.permanent.e2e-spec.ts",
    "test:e2e:circuit-breaker": "jest --config ./tests/e2e/jest-e2e.json --runInBand tests/e2e/payments.circuit-breaker.e2e-spec.ts",
    "test:e2e:idempotency": "jest --config ./tests/e2e/jest-e2e.json --runInBand tests/e2e/payments.idempotency.e2e-spec.ts",
    "test:e2e:retry-after": "jest --config ./tests/e2e/jest-e2e.json --runInBand tests/e2e/payments.retry-after.e2e-spec.ts",
    "test:e2e:durable-scheduler": "jest --config ./tests/e2e/jest-e2e.json --runInBand tests/e2e/payments.durable-scheduler.e2e-spec.ts",
    "test:e2e:exhaustion": "jest --config ./tests/e2e/jest-e2e.json --runInBand tests/e2e/payments.exhaustion.e2e-spec.ts",
    "db:migrate": "tsx --env-file=../../.env node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "db:migrate:revert": "tsx --env-file=../../.env node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "db:migration:generate": "tsx --env-file=../../.env node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^3.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@retry-failure/resilience": "workspace:^",
    "@retry-failure/security": "workspace:^",
    "axios": "^1.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cockatiel": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "joi": "^17.13.0",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.23.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  }
}
