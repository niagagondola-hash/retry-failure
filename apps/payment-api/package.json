{
  "name": "payment-api",
  "version": "0.1.0",
  "private": true,
  "description": "Payment API — NestJS 11 + TypeORM + Cockatiel + PostgreSQL",
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "tsx node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "db:migrate:revert": "tsx node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "db:migration:generate": "tsx node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^3.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "@retry-failure/resilience": "workspace:^",
    "axios": "^1.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cockatiel": "^4.0.0",
    "joi": "^17.13.0",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  }
}
