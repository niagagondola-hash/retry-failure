# frontend-vue env example — AUTH-20.
#
# VITE_API_URL: Base origin of the BFF (payment-api). Used by the auth-aware
# axios instance (`src/api/axios.ts`) and for the 401 full-page redirect.
#   - Set to `http://localhost:3001` (default) for cross-origin dev (CORS required).
#   - Set to empty string to fall back to same-origin + the Vite dev proxy
#     (see `vite.config.ts`). Useful when the BE does not enable CORS credentials.
VITE_API_URL=http://localhost:3001

# Pre-existing vars (kept for backwards compat with the payments/gateway clients).
VITE_PAYMENT_API_URL=http://localhost:3001
VITE_GATEWAY_MOCK_URL=http://localhost:3002
