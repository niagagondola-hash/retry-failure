# ============================================================
# KONDISI SANDBOX - contoh env file untuk environment Z.ai cloud sandbox
# ============================================================
# Cara pakai:
#   1. Copy file ini ke apps/payment-api/.env:
#      cp .env.sandbox.example apps/payment-api/.env
#   2. Sesuaikan DB credentials bila ada external PostgreSQL.
#      Bila tidak ada DB -> skip DB-dependent commands, gunakan mock repository.
#   3. Enable pnpm via corepack:
#      corepack enable pnpm && corepack prepare pnpm@9.12.0 --activate
#   4. Jalankan `pnpm install` lalu `pnpm dev`.
#
# Asumsi kondisi SANDBOX:
#   - Docker TIDAK tersedia (`docker --version` -> command not found)
#   - pnpm TIDAK pre-installed -> enable via `corepack enable pnpm`
#   - Port 3000 dipakai Next.js preview (Z.ai sandbox auto-start) -> payment-api shift ke 3001
#   - PostgreSQL butuh external instance, atau skip DB tests + pakai mock repository
# ============================================================

# === Payment API (NestJS) ===
# Port 3001 (port 3000 dipakai Next.js preview di sandbox Z.ai).
# Gateway mock di port 3002 (port 3001 dipakai gateway-mock; port 3000+3001 konflik dengan Next.js preview + payment-api).
PORT=3001
GATEWAY_URL=http://localhost:3002
GATEWAY_TIMEOUT_MS=2000

# === Cockatiel retry policy ===
# (Sama dengan KONDISI LOCAL - config aplikasi tidak bergantung lingkungan)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=8000
RETRY_JITTER_RATIO=0.1

# === Durable retry (scheduler) ===
MAX_TOTAL_RETRIES=5

# === Circuit breaker ===
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_MS=10000

# === Scheduler interval ===
SCHEDULER_INTERVAL_MS=5000

# === PostgreSQL ===
# Opsi A: connect ke external PostgreSQL instance (set DB_HOST ke host eksternal).
# Opsi B: bila tidak ada external PostgreSQL -> skip DB commands, gunakan mock repository untuk dev.
# Default: localhost (asumsi ada external PostgreSQL instance yang berjalan di host sandbox).
DB_HOST=localhost
DB_PORT=5432
DB_USER=retry_failure
DB_PASS=retry_failure
DB_NAME=retry_failure
DB_SCHEMA=public

# === Observability ===
# OTel OTLP endpoint: bila Jaeger tidak jalan (no Docker), endpoint ini tidak terpakai.
# Aplikasi tetap jalan tanpa OTel export - trace ID tetap di-generate via AsyncLocalStorage.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# === OpenTelemetry toggle (TASK-11b extension) ===
# false (default sandbox): AsyncLocalStorage + randomUUID trace ID (TASK-11 simplified).
#   SDK tidak start — fallback ALS, tidak ada Jaeger export, tidak ada ECONNREFUSED spam.
# true (local with Docker): Full OTel SDK + Jaeger export (TASK-11b).
#   Butuh: docker compose up -d jaeger (Jaeger all-in-one di port 16686 + 4318).
#   Set true di apps/payment-api/.env, lalu start payment-api + gateway-mock.
IS_OTEL=false

# === Frontend URLs ===
# Next.js preview sudah otomatis jalan di port 3000 (sandbox Z.ai).
# Vue+PrimeVue dev server di port 5173 (via `pnpm --filter frontend-vue dev`).
NEXTJS_DASHBOARD_URL=http://localhost:3000
VUE_DASHBOARD_URL=http://localhost:5173

# === Catatan akses cross-service dari Next.js sandbox ===
# Next.js preview di port 3000 mengakses payment-api (port 3001) dan gateway-mock (port 3002)
# via Caddy gateway dengan query param `?XTransformPort=NNNN`.
# Contoh fetch dari client Next.js:
#   fetch('/api/payments?XTransformPort=3001')
#   fetch('/admin/config?XTransformPort=3002', { method: 'PUT', ... })
# JANGAN hardcode http://localhost:3001 atau http://localhost:3002 di client code.

# ============================================================
# === Auth Integration (Plan 2 AUTH-16/17/23, sandbox profile) ===
# ============================================================
# Per plan2 section 14.5: sandbox pakai SESSION_STORE=memory (no Redis).
# AUTH_MODE=mock (auth-mock running on host port 4001 via `pnpm dev:auth-mock`).
# CSRF enabled for completeness; bisa disable untuk sandbox convenience.
#
# Aktifkan bila Plan 2 auth integration sudah di-wire (AUTH-17 + AUTH-18).
# Default: commented out agar Plan 1 (existing) tetap jalan tanpa auth.

# === OAuth2 / Auth mode (sandbox — pakai auth-mock) ===
# AUTH_MODE=mock
# AUTH_BASE_URL=http://localhost:4001
# AUTH_ISSUER=http://localhost:4001
# JWT_AUDIENCE=payment-api
# OAUTH_CLIENT_ID=payment-api
# OAUTH_CLIENT_SECRET=dev-client-secret
# OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback
# OAUTH_SCOPES=openid profile

# === Session (memory — no Redis in sandbox) ===
# SESSION_STORE=memory
# SESSION_SECRET=change-me-to-32-chars-or-more-aaaa
# SESSION_TTL_SEC=28800
# SESSION_COOKIE_NAME=sid
# SESSION_COOKIE_SAMESITE=Lax

# === JWT verification ===
# JWT_CLOCK_TOLERANCE_SEC=5
# JWKS_CACHE_TTL_SEC=300

# === Lazy sync (SWR — plan2 §8) ===
# SYNC_FRESH_TTL_MS=300000
# SYNC_STALE_TTL_MS=1800000
# SYNC_MAX_STALE_TTL_MS=7200000
# SYNC_BLOCKING_TIMEOUT_MS=2000
# SYNC_LOCK_TTL_SEC=10

# === CSRF + Rate limit ===
# CSRF_ENABLED=true
# THROTTLER_DISABLED=false
# RATE_LIMIT_LOGIN_PER_MIN=10

# === CORS (plan2 §16) ===
# CORS_ORIGIN=http://localhost:5173

# === NO REDIS_URL (SESSION_STORE=memory in sandbox) ===
# Bila multi-instance sandbox butuh Redis, set SESSION_STORE=redis + REDIS_URL.

# === Auth-mock port (apps/auth-mock — Plan 2 AUTH-01) ===
# Dipakai oleh apps/auth-mock/src/main.ts. Auth-mock running via
# `pnpm dev:auth-mock` di host (port 4001).
# AUTH_MOCK_PORT=4001
