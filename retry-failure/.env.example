# ============================================================
# KONDISI LOCAL - contoh env file untuk environment development lokal
# ============================================================
# Cara pakai:
#   1. Copy file ini ke apps/payment-api/.env:
#      cp .env.example apps/payment-api/.env
#   2. Sesuaikan DB credentials bila perlu (default: docker compose postgres service).
#   3. Jalankan `docker compose up -d postgres` lalu `pnpm db:migrate`.
#   4. Jalankan `pnpm dev`.
#
# Asumsi kondisi LOCAL:
#   - Docker tersedia (`docker --version` output version string)
#   - pnpm terinstall (`pnpm --version` output version string)
#   - Port 3000 bebas (tidak ada Next.js preview yang berjalan otomatis)
#   - PostgreSQL via docker compose service `postgres` (port 5432)
# ============================================================

# === Payment API (NestJS) ===
# Port default 3000 (per plan asli). Gateway mock di port 3001.
PORT=3000
GATEWAY_URL=http://localhost:3001
GATEWAY_TIMEOUT_MS=2000

# === Cockatiel retry policy ===
# NOTE: In Cockatiel v4, maxAttempts = "max number of RETRIES" (NOT total attempts).
# So maxAttempts=3 means 1 initial + 3 retries = 4 total fn() calls per execution cycle.
# See packages/resilience/src/policies/types.ts for details.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=8000
RETRY_JITTER_RATIO=0.1

# === Durable retry (scheduler) ===
MAX_TOTAL_RETRIES=5

# === Scheduler delay between cycles ===
# Delay sebelum payment yang scheduled_for_retry bisa di-pick scheduler lagi.
# Default code: 30000 (30s) - TERLALU LAMBAT untuk E2E test.
# Untuk test scenario 6 & 7, set ke 2000 (2s) supaya test selesai cepat.
# Production: 30000-60000 (1 minute) supaya gateway punya waktu recover.
SCHEDULER_BASE_DELAY_MS=2000

# === Circuit breaker ===
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_MS=10000

# === Scheduler interval ===
SCHEDULER_INTERVAL_MS=5000

# === Database driver (TASK-14b dual environment) ===
# postgres (default): production + local dev with Docker PostgreSQL
# sqlite: sandbox/test environment without PostgreSQL/Docker
DB_TYPE=postgres

# === PostgreSQL (used when DB_TYPE=postgres) ===
# Default credentials sesuai docker-compose.yml service `postgres`.
# Ubah bila PostgreSQL lokal punya credentials berbeda.
DB_HOST=localhost
DB_PORT=5432
DB_USER=retry_failure
DB_PASS=retry_failure
DB_NAME=retry_failure
DB_SCHEMA=public

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# === Frontend URLs (opsional, untuk reference dashboard) ===
# Next.js (parent root, port 3000 bila dipakai):
NEXTJS_DASHBOARD_URL=http://localhost:3000
# Vue+PrimeVue (apps/frontend-vue, Vite dev):
VUE_DASHBOARD_URL=http://localhost:5173

# === OpenTelemetry toggle (TASK-11b extension) ===
# false (default): AsyncLocalStorage + randomUUID trace ID
# true: Full OTel SDK + Jaeger (butuh Docker, execute TASK-11b first)
IS_OTEL=false

# ============================================================
# === Auth Integration (Plan 2 AUTH-16/17/23, plan2 section 16) ===
# ============================================================
# Aktifkan bila Plan 2 auth integration sudah di-wire (AUTH-17 + AUTH-18).
# Default: commented out agar Plan 1 (existing) tetap jalan tanpa auth.

# === OAuth2 / Auth mode ===
# oauth | mock | disabled
#   oauth    -> production (real auth service via AUTH_BASE_URL)
#   mock     -> dev (use apps/auth-mock di port 4001)
#   disabled -> skip guards + fake user dari AUTH_DISABLED_* (plan2 §14.6)
# AUTH_MODE=mock
# AUTH_BASE_URL=http://localhost:4001
# AUTH_ISSUER=http://localhost:4001
# JWT_AUDIENCE=payment-api
# OAUTH_CLIENT_ID=payment-api
# OAUTH_CLIENT_SECRET=dev-client-secret
# OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback
# OAUTH_SCOPES=openid profile

# === AUTH_MODE=disabled fallback user (plan2 §14.6) ===
# Wajib diisi bila AUTH_MODE=disabled (untuk dev/test tanpa OAuth flow).
# AUTH_DISABLED_USER_ID=00000000-0000-0000-0000-000000000001
# AUTH_DISABLED_USERNAME=disabled-user
# AUTH_DISABLED_ROLE_ID=00000000-0000-0000-0000-000000000002
# AUTH_DISABLED_IS_SUPER_ADMIN=true
# AUTH_DISABLED_PERMISSION_CODES=*

# === JWT verification (plan2 §5.3) ===
# JWT_CLOCK_TOLERANCE_SEC=5
# JWKS_CACHE_TTL_SEC=300

# === Session store (plan2 §9.4 + §14.4) ===
# redis | memory
#   redis  -> production + multi-instance dev (butuh REDIS_URL)
#   memory -> sandbox single-instance (plan2 §21.12)
# SESSION_STORE=redis
# SESSION_SECRET=change-me-to-32-chars-or-more-aaaa
# SESSION_TTL_SEC=28800
# SESSION_COOKIE_NAME=sid
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_ENCRYPTION_KEY=

# === Lazy sync (SWR — plan2 §8) ===
# SYNC_FRESH_TTL_MS=300000
# SYNC_STALE_TTL_MS=1800000
# SYNC_MAX_STALE_TTL_MS=7200000
# SYNC_BLOCKING_TIMEOUT_MS=2000
# SYNC_LOCK_TTL_SEC=10

# === CORS (plan2 §16) ===
# CORS_ORIGIN=http://localhost:5173

# === Rate limit (plan2 §16) ===
# RATE_LIMIT_LOGIN_PER_MIN=10
# THROTTLER_DISABLED=false

# === CSRF (plan2 §12 + AUTH-15) ===
# Double-submit cookie pattern: XSRF-TOKEN cookie + X-CSRF-Token header.
# CSRF_ENABLED=true

# === Redis (only if SESSION_STORE=redis — plan2 §14.4) ===
# Docker compose service `redis` di port 6379.
# REDIS_URL=redis://localhost:6379

# === Auth-mock (apps/auth-mock — Plan 2 AUTH-01) ===
# Dipakai oleh apps/auth-mock/src/main.ts (port 4001).
# AUTH_MOCK_PORT=4001
